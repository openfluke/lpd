# Auto-start test 1 (cnn2/bit/mnist) without menu
LPD_TEST=1
LPD_AUTOSTART=true

# Tide dashboard (River compare is on the same port via tide integration)
LPD_ADDR=0.0.0.0:8301

# MNIST cache — IDX files land in downloads/mnist/ (not a repo-root mnist/ folder)
# LPD_DATA_DIR=downloads/mnist

# Results + checkpoint for this test
LPD_OUT_DIR=cnn2/bit/mnist/results

# Training (per-cell LR is swept: 0.05, 0.5 — LPD_LR only affects dash subtitle)
LPD_TRAIN_N=2000
LPD_WORKERS=8
LPD_LR=0.05

# Split across machines: Mac A shard 0/2, Mac B shard 1/2
# LPD_SHARD=0
# LPD_SHARDS=2
# LPD_PEER_NAME=mac-a-cnn2-bit

# Worker: register with ocean on the watcher Mac
# LPD_OCEAN_URL=http://192.168.1.50:8090

# Watcher Mac only (no training):
# LPD_OCEAN_ONLY=true
# LPD_OCEAN_ADDR=0.0.0.0:8090
# LPD_OCEAN_PEERS=http://192.168.1.51:8301,http://192.168.1.52:8301
