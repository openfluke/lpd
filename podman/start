#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=common.sh
source "${SCRIPT_DIR}/common.sh"

need_podman
ensure_machine

DO_BUILD=1
RECREATE=0
EXTRA=()
for arg in "$@"; do
	case "$arg" in
	--no-build) DO_BUILD=0 ;;
	--recreate) RECREATE=1 ;;
	*) EXTRA+=("$arg") ;;
	esac
done

if [[ $DO_BUILD -eq 1 ]]; then
	build_binary
	build_image
elif [[ ! -x "${BINARY}" ]]; then
	die "no bin/lpd — run ./podman/build first"
elif ! podman image exists "${IMAGE}" >/dev/null 2>&1; then
	build_image
fi

if container_running; then
	echo "already running (${NAME})"
	print_urls
	exit 0
fi

if container_exists && [[ $RECREATE -eq 0 ]]; then
	echo "Starting existing container ${NAME}…"
	podman start "${NAME}" >/dev/null
	print_urls
	exit 0
fi

if container_exists; then
	echo "Recreating container ${NAME}…"
	podman rm -f "${NAME}" >/dev/null 2>&1 || true
fi

run_container "${EXTRA[@]}"
print_urls
